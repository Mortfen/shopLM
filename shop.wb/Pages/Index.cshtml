@page
@model shop.wb.Pages.IndexModel
@{
    ViewData["Title"] = "Авторские изделия";
    Layout = "_Layout";
}

<!-- Hero -->
<section class="page-hero">
    <div class="container">
        <div style="display:inline-flex; align-items:center; gap:8px; margin-bottom:20px;
                    padding:6px 14px; border:1px solid var(--c-border);
                    border-radius:20px; font-size:13px; color:var(--c-muted);">
            <span style="width:7px;height:7px;border-radius:50%;background:var(--c-accent);
                         display:inline-block;"></span>
            Количество изделий сейчас @Model.Product.Count
        </div>
        <h1>Авторские изделия<br>с душой</h1>
        <p>Уникальные вещи, сделанные руками мастеров.<br>Найдите что-то особенное.</p>
        <div style="display:flex; gap:12px; margin-top:32px; flex-wrap:wrap;">
            <a href="#catalog" class="btn btn-primary">Смотреть каталог</a>
            <a asp-page="/Producs/Create" class="btn-ghost">Продать изделие</a>
        </div>

        <!-- Stats row -->
        <div style="display:flex; gap:40px; margin-top:52px; padding-top:32px;
                    border-top:1px solid var(--c-border);">
            <div>
                <div style="display:inline-flex; align-items:center; gap:8px; margin-bottom:20px;
                    padding:6px 14px; border:1px solid var(--c-border);
                    border-radius:20px; font-size:13px; color:var(--c-muted);">
                    <span style="width:7px;height:7px;border-radius:50%;background:var(--c-accent);
                         display:inline-block;"></span>@Model.SellerCount
                </div>
                <div style="font-size:13px; color:var(--c-muted); margin-top:2px;">Количество мастеров сейчас</div>
            </div>
            <div>
                <div style="font-family:'DM Serif Display',serif; font-size:28px;">Пока нет, станьте первыми!</div>
                <div style="font-size:13px; color:var(--c-muted); margin-top:2px;">Изделий продано</div>
            </div>
            <div>
                <div style="font-family:'DM Serif Display',serif; font-size:28px;">4.9</div>
                <div style="font-size:13px; color:var(--c-muted); margin-top:2px;">Средняя оценка</div>
            </div>
        </div>
    </div>
</section>

<!-- Filters -->
<div class="filters-bar" style="justify-content: center;">
    <a asp-page="/Index"
       class="filter-chip @(Model.Category == null ? "active" : "")">
        Все
    </a>
    @foreach (var cat in new[] { "Вязание", "Керамика", "Украшения", "Живопись", "Текстиль", "Дерево" })
    {
        <a asp-page="/Index" asp-route-category="@cat"
           class="filter-chip @(Model.Category == cat ? "active" : "")">
            @cat
        </a>
    }
</div>

<!-- Catalog -->
<section class="section" id="catalog">
    <div class="product-grid">
        @if (Model.Product.Any())
        {
            @foreach (var product in Model.Product)
            {
                <div class="card product-card">

                    <a asp-page="/Producs/Details" asp-route-id="@product.Id">
                        <div class="product-img">
                            <img src="@(product.ImageUrl != null
                                                               ? Model.ApiBase + product.ImageUrl
                                                               : "https://placehold.co/400x400/1A2E22/4E9A6A?text=Фото")"
                         alt="@product.Title" />
                </div>
                <div class="product-info">
                    <div class="product-name">@product.Title</div>
                    <div class="flex-between">
                        <div class="product-price">@product.Price <span>₽</span></div>
                        @if (!string.IsNullOrEmpty(product.Category))
                                {
                                    <span class="tag">@product.Category</span>
                                }
                            </div>
                        </div>
                    </a>

                    <form method="post" asp-page-handler="Buy" style="padding: 0 16px 16px;">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <input type="hidden" name="price" value="@product.Price" />
                        <input type="hidden" name="title" value="@product.Title" />
                        <input type="hidden" name="imageUrl" value="@product.ImageUrl" />
                        <button type="submit" class="btn btn-primary" style="width:100%;">
                            Добавить в корзину
                        </button>
                    </form>

                </div>
            }
        }
        else
        {
            <p class="text-muted">Товаров пока нет.</p>
        }
    </div>

</section>