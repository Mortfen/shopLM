@page
@model shop.wb.Pages.Account.RegisterModel
@{
	ViewData["Title"] = "Регистрация";
	Layout = "_Layout";
}
<div class="auth-wrap">
    <div class="auth-card">

        <h1>Создать аккаунт</h1>
        <p class="auth-sub">Присоединяйтесь — покупайте и продавайте авторские изделия</p>

        <form method="post">
            <div class="gap-stack">

                <div class="form-group">
                    <label asp-for="Input.FullName">Имя</label>
                    <input asp-for="Input.FullName"
                           type="text"
                           placeholder="Как вас зовут" />
                    <span asp-validation-for="Input.FullName" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email"
                           type="text"
                           placeholder="you@example.com"
                           autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password">Пароль</label>
                    <input asp-for="Input.Password"
                           type="password"
                           placeholder="••••••••"
                           autocomplete="new-password" />
                    <span class="form-hint">Минимум 8 символов, заглавная буква, цифра и спецсимвол</span>
                    <span asp-validation-for="Input.Password" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Повторите пароль</label>
                    <input asp-for="Input.ConfirmPassword"
                           type="password"
                           placeholder="••••••••"
                           autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="form-error"></span>
                </div>

            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; margin-top:24px; padding:12px;">
                Зарегистрироваться
            </button>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p style="color:var(--c-danger); font-size:13px; text-align:center; margin-top:12px;">
                    @Model.ErrorMessage
                </p>
            }
        </form>

        <div class="auth-divider">или</div>

        <a asp-page="/Account/Login" class="btn-outline"
           style="width:100%; text-align:center; display:block; padding:12px;">
            Уже есть аккаунт — войти
        </a>

        <p class="auth-footer">
            Регистрируясь, вы соглашаетесь с
            <a href="#">условиями использования</a>
        </p>

    </div>
</div>
