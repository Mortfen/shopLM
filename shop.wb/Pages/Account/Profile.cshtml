@page
@model shop.wb.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Профиль";
    Layout = "_Layout";
}

<div class="container">
    <div class="profile-wrap">

        <!-- Header -->
        <div class="profile-header">
            <div class="profile-avatar">
                @(Model.Profile?.FullName.Substring(0, 1).ToUpper() ?? "?")
            </div>
            <div>
                <div class="profile-name">@Model.Profile?.FullName</div>
                <div class="profile-meta">@Model.Profile?.Email</div>
                <div style="margin-top:10px; display:flex; gap:8px;">
                    @foreach (var role in Model.Profile?.Roles ?? new())
                    {
                        <span class="tag">@role</span>
                    }
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-val">@Model.MyProducts.Count</div>
                <div class="stat-label">Товаров размещено</div>
            </div>
        </div>

        @if (!User.IsInRole("Seller"))
        {
            <form method="post" asp-page-handler="BecomeSeller">
                <button type="submit" class="btn btn-primary">
                    Стать продавцом
                </button>
            </form>
        }
        else
        {
            <span class="tag">Продавец</span>
        }



        <!-- Tabs -->
        <div class="profile-tabs">
            <div class="profile-tab active">Мои товары</div>
            <div class="profile-tab">Настройки</div>
        </div>

        <!-- My products tab -->
        <div id="tab-products">
            <div class="flex-between" style="margin-bottom:20px;">
                <span class="text-sm text-muted">@Model.MyProducts.Count товара</span>

                @if (User.IsInRole("Seller"))
                {
                    <a asp-page="/Producs/Create" class="btn btn-primary"
                       style="padding:9px 18px; font-size:13px;">
                        + Добавить товар
                    </a>
                }
            </div>

            @if (Model.MyProducts.Any())
            {
                <div class="product-grid">
                    @foreach (var product in Model.MyProducts)
                    {
                        <div class="card product-card" style="position:relative;">
                            <img src="@(product.ImageUrl != null
                                               ? Model.ApiBase + product.ImageUrl
                                               : "https://placehold.co/400x400/EBF2ED/2D5A3D?text=Фото")"
                         alt="@product.Title" />
                            <div class="product-info">
                                <div class="product-name">@product.Title</div>
                                <div class="product-seller">@product.Quantity в наличии</div>
                                <div class="flex-between">
                                    <div class="product-price">@product.Price <span>₽</span></div>
                                    <a asp-page="/Producs/Edit" asp-route-id="@product.Id"
                                       style="font-size:12px; color:var(--c-accent);">К товару</a>
                                </div>
                        <div class="flex-between">                
                            <form method="post" asp-page-handler="DeleteProduct">
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="cart-remove" title="Удалить">
                                    Удалить
                                </button>
                            </form>
                        </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">У вас пока нет товаров.</p>
            }
        </div>

        <!-- Settings tab -->
        <form method="post" asp-page-handler="SaveProfile">
            <div id="tab-settings" style="display:none; max-width:520px;">
                <div class="form-section">
                    <div class="form-section-title">Личные данные</div>
                    <div class="gap-stack">
                        <div class="form-group">
                            <label>Имя</label>
                            <input type="text" name="FullName" value="@Model.Profile?.FullName" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="Email" value="@Model.Profile?.Email" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Кнопка СНАРУЖИ скрытого div, но внутри формы -->
            <div id="tab-settings-btn" style="display:none; margin-top:16px;">
                <button type="submit" class="btn btn-primary" style="padding:11px 28px;">
                    Сохранить
                </button>
            </div>
        </form>
<script>
    document.querySelectorAll('.profile-tab').forEach((tab, i) => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.profile-tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

                       document.getElementById('tab-settings').style.display = i === 1 ? 'block' : 'none';
            document.getElementById('tab-settings-btn').style.display = i === 1 ? 'block' : 'none';
        });
    });
</script>