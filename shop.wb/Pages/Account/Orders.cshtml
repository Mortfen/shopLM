@page
@model shop.wb.Pages.Account.OrdersModel
@{
	ViewData["Title"] = "Корзина";
	Layout = "_Layout";
}
<div class="container">
    <div class="cart-wrap">

        <!-- Заголовок -->
        <div class="flex-between" style="margin-bottom: 32px;">
            <h1 style="font-family:'DM Serif Display',serif; font-size:32px; font-weight:400;">
                Корзина
            </h1>
            <span class="text-sm text-muted">3 товара</span>
        </div>

        <div class="cart-layout">

            <!-- Список товаров -->
            <div class="cart-items">

                @* В реальном коде foreach по Model.Items *@
                @for (int i = 0; i < 3; i++)
                {
                    <div class="cart-item">
                        <div class="cart-item-img">
                            <img src="https://placehold.co/120x120/1A2E22/4E9A6A?text=Фото" alt="Товар" />
                        </div>
                        <div class="cart-item-info">
                            <div class="cart-item-name">Вязаный свитер ручной работы</div>
                            <div class="cart-item-seller text-muted text-sm">Анна М.</div>
                            <div class="cart-item-meta">
                                <span class="tag-gray tag">Шерсть · Синий</span>
                            </div>
                        </div>
                        <div class="cart-item-actions">
                            <div class="qty-control">
                                <button class="qty-btn">−</button>
                                <span class="qty-val">1</span>
                                <button class="qty-btn">+</button>
                            </div>
                            <div class="cart-item-price">2 400 <span class="text-muted" style="font-size:13px;">₽</span></div>
                            <button class="cart-remove" title="Удалить">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.5">
                                    <path d="M18 6L6 18M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }

                <!-- Пустая корзина (скрыта пока есть товары) -->
                <div class="cart-empty" style="display:none;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
                         stroke="var(--c-muted)" stroke-width="1">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 01-8 0" />
                    </svg>
                    <p>Корзина пуста</p>
                    <a asp-page="/Index" class="btn btn-primary" style="margin-top:16px;">
                        Перейти в каталог
                    </a>
                </div>

            </div>

            <!-- Итого -->
            <div class="cart-summary card">
                <div class="cart-summary-title">Итого</div>

                <div class="cart-summary-rows">
                    <div class="cart-summary-row">
                        <span class="text-muted">Товары (3)</span>
                        <span>7 200 ₽</span>
                    </div>
                    <div class="cart-summary-row">
                        <span class="text-muted">Доставка</span>
                        <span class="text-muted">—</span>
                    </div>
                </div>

                <div class="cart-summary-total">
                    <span>Итого</span>
                    <span>7 200 ₽</span>
                </div>

                <button class="btn btn-primary" style="width:100%; padding:13px; margin-top:20px;">
                    Оформить заказ
                </button>

                <a asp-page="/Index"
                   style="display:block; text-align:center; margin-top:14px;
                          font-size:13px; color:var(--c-muted);">
                    Продолжить покупки
                </a>
            </div>

        </div>

    </div>
</div>